# ─── PROXY HAVUZU ──────────────────────────────────────────
# 21.09.2026 — PerimeterX ev IP'sini damgaladigi icin proxy ZORUNLU.
# Virgulle ayrilmis liste. Failover: ayni anda tek proxy aktif, block yiyen
# dinlendirilir, sonrakine gecilir. Her proxy AYRI Brave profili kullanir
# (cf_clearance/PX cerezi karismasin).
# Format: http://kullanici:sifre@host:port
PROXY_LIST=

# Ev IP'si — proxy'nin gercekten calistigini dogrulamak icin (cikis IP bu
# degere ESITSE proxy calismiyor demektir). Bos birakilirsa kontrol atlanir.
EV_IP=

# ─── TELEGRAM (Faz 4) ──────────────────────────────────────
# Faz 1'de Telegram kullanilmiyor — Faz 4'te (bildirim) doldurulacak
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ─── BRAVE SURUMU ──────────────────────────────────────────
# Brave chrome major version.
# Bos birak → undetected_chromedriver auto-detect eder (onerilen).
# Auto-detect calismazsa buraya elle yaz (orn: 153).
# Brave'in surumunu ogrenmek icin: brave://version → "Chrome" satirindaki ilk sayi
BRAVE_VERSION_MAIN=

# ─── PERIMETERX SAVUNMASI (21.09.2026) ─────────────────────
# PX_OTOMATIK_COZ: "Press & Hold" challenge'ini bot kendi cozmeye calissin mi?
#   true  → insan mudahalesi olmadan otomatik basili-tut simulasyonu (CDP)
#   false → eski davranis (kullanici elle cozer)
PX_OTOMATIK_COZ=true

# PX_MAX_DENEME: otomatik cozum kac kez denenecek (basarisizsa kullaniciya birakilir)
PX_MAX_DENEME=3

# Fingerprint — cikis IP'siyle TUTARLI olmali (TR proxy → TR timezone/locale).
# IP Istanbul ama timezone UTC ise PX aninda "bot" isaretler.
PX_TIMEZONE=Europe/Istanbul
PX_LOCALE=tr-TR
PX_LANG=tr-TR,tr;q=0.9,en-US;q=0.8,en;q=0.7

# ─── TELEGRAM: HAM YENI ILAN AKISI (@otobotpro_bot) ──────────────────
# Virgulle ayrilmis liste olabilir (birden fazla alici). Ozel sohbete
# yazmak icin karsi taraf botu BIR KEZ baslatmis olmali.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
OTO_TG_BESLEME=1
OTO_TG_ARA=1.0

# ─── TELEGRAM: KELEPIR AVCISI, AYRI KANAL (@otokelepir_bot) ──────────
# Bos birakilirsa ham akisin hedefine duser. Ayri kanal onerilir:
# kelepir zamana duyarli, ham akisin kuyrugunda beklememeli.
OTO_AVCI_TOKEN=
OTO_AVCI_CHAT_ID=
