{
  "manifest_version": 3,
  "name": "Oto Kelepir Toplayici",
  "version": "1.1",
  "description": "sahibinden liste sayfalarini (otomobil + PC bileseni) sayfanin kendi baglamindan izler; yeni ilanlari yerel sunucuya yazar. WebDriver/CDP kullanmaz.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://www.sahibinden.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.sahibinden.com/otomobil*",
        "https://www.sahibinden.com/masaustu-donanim*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Oto Kelepir Toplayici"
  }
}
